{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "12 Step Win Build (Debug)",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\run-msvc-qmake-task.cmd",
      "args": [
        "..\\QT\\12StepEditor.pro",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\build-12StepEditor-Desktop_Qt_6_3_2_MSVC2019_64bit-Debug"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build"
      }
    },
    {
      "label": "12 Step Win Build",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\run-msvc-qmake-task.cmd",
      "args": [
        "..\\QT\\12StepEditor.pro",
        "build",
        "${workspaceFolder}\\build-12StepEditor-Desktop_Qt_6_3_2_MSVC2019_64bit-Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "12 Step Win Clean",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\run-msvc-qmake-task.cmd",
      "args": [
        "..\\QT\\12StepEditor.pro",
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\build-12StepEditor-Desktop_Qt_6_3_2_MSVC2019_64bit-Debug"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "12 Step Win Tail Log",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\tail-log.ps1",
        "${env:APPDATA}\\KeithMcMillenInstruments\\12 Step Editor\\logs"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "12 Step Win Installer",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\make-installer.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "12 Step Win Installer (No Signing)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\make-installer.ps1",
        "-DisableSigning"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "12 Step Win Deploy",
      "dependsOrder": "sequence",
      "dependsOn": [
        "12 Step Win Build",
        "12 Step Win Installer"
      ],
      "problemMatcher": []
    },
    {
      "label": "12 Step Win Deploy (No Signing)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "12 Step Win Build",
        "12 Step Win Installer (No Signing)"
      ],
      "problemMatcher": []
    },
    {
      "label": "12 Step Mac Build",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/run-qmake-task.sh",
      "args": [
        "${workspaceFolder}/QT/12StepEditor.pro",
        "build",
        "${workspaceFolder}/build-macos-release",
        "CONFIG+=release"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "12 Step Mac Build (Debug)",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/run-qmake-task.sh",
      "args": [
        "${workspaceFolder}/QT/12StepEditor.pro",
        "build",
        "${workspaceFolder}/build-macos-debug",
        "CONFIG+=debug"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "12 Step Mac Clean",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/run-qmake-task.sh",
      "args": [
        "${workspaceFolder}/QT/12StepEditor.pro",
        "clean",
        "${workspaceFolder}/build-macos-release"
      ],
      "problemMatcher": []
    },
    {
      "label": "12 Step Mac Launch (Console)",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/launch-on-console.sh",
      "args": [
        "${workspaceFolder}/build-macos-release/12 Step Editor.app/Contents/MacOS/12 Step Editor"
      ],
      "dependsOn": [
        "12 Step Mac Build"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "12 Step Mac Make DMG",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/make-dmg-mac.sh",
      "args": [
        "12 Step Editor",
        "${workspaceFolder}/build-macos-release/12 Step Editor.app"
      ],
      "options": {
        "env": {
          "KMI_VERSION_PRO": "${workspaceFolder}/QT/12StepEditor.pro",
          "KMI_QMLDIR": "${workspaceFolder}/QT"
        }
      },
      "dependsOn": [
        "12 Step Mac Build"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "12 Step Mac Deploy",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/release-github-mac.sh",
      "args": [
        "Muse-Kinetics/12-step-editor-qt6",
        "12 Step Editor",
        "${workspaceFolder}/build-macos-release/12 Step Editor.app"
      ],
      "options": {
        "env": {
          "KMI_VERSION_PRO": "${workspaceFolder}/QT/12StepEditor.pro"
        }
      },
      "dependsOn": [
        "12 Step Mac Make DMG"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}

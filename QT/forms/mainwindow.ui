    <widget class="QToolButton" name="update">
     <property name="enabled">
      <bool>false</bool>
     </property>
     <property name="geometry">
      <rect>
       <x>22</x>
       <y>65</y>
       <width>210</width>
       <height>28</height>
      </rect>
     </property>
     <property name="toolTip">
      <string>&quot;Make it so.&quot;&lt;p&gt;Update a connected 12 Step's presets with the current setlist.&lt;p&gt;&lt;b&gt;Note&lt;/b&gt;: All presets currently on the 12 Step board will be overwritten.</string>
     </property>
     <property name="styleSheet">
      <string notr="true">/*---------- QToolButton ---------*/
QToolButton
{
	background: rgb(60, 60, 60);
	border: 2px solid rgb(245,245,245);
	font: 16pt &quot;Futura PT&quot;;
	color: white;
}

QToolButton:pressed
{
	background: rgb(245, 245, 245);
	border: 2px solid rgb(245, 245, 245);
	font: 16pt &quot;Futura PT&quot;;
	color: black;
}

QToolButton::disabled
{
	background: rgba(20, 20, 20, 100);
	border: 2px solid rgb(100, 100, 100);
	font: 16pt &quot;Futura PT&quot;;
	color: rgb(100, 100, 100);
}

QToolTip
{
	font: 12pt &quot;Futura PT&quot;;
}</string>

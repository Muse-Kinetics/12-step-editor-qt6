  <property name="styleSheet">
   <string notr="true">/*QWidget
{

}*/

QToolTip
{
	border: 1px solid rgb(242, 242, 242);
	background-color: rgb(40, 40, 40);
	font: 8pt &quot;Corbel&quot;;
	color: rgb(242, 242, 242);
	padding: 2px;
	min-height: 24px;
}

QToolButton:focus
{
	border: 2px solid rgb(0, 174, 239);
}


/*----------- QComboBox ------------*/
QComboBox
{
	font: 14px &quot;Corbel&quot;;
 /*
	border: 2px solid rgb(245, 245, 245);
*/
	background: rgb(60, 60, 60);
	color: white;
	padding: 1px 3px 1px 1px;
    combobox-popup: 0;
 }

/*----------- QComboBox ------------*/

/* dropdown box*/
QComboBox QListView
{
   /* border: 1px solid rgb(255,255,255);*/
	color: white;
	font: 10px &quot;Corbel&quot;;
	padding-left: 3px;
	padding-right: 0px;
	min-width: 200px;
    height: 200px;
}

/*----------- dropdown items hovered ------------*/
QComboBox QAbstractItemView
{
    background-color: rgb(40, 40, 40);
    selection-color: white;
    selection-background-color: rgb(0,174,239);
   /* min-width: 200px;*/
}

QComboBox::item:alternate
{
	background: rgb(90, 90, 90);
}

QComboBox::item:selected
{
	border: 1px solid transparent;
	background: rgb(0,174,239);
}

QComboBox::indicator
{
	background-color: transparent;
	selection-background-color: transparent;
	color: transparent;
	selection-color: white;
}

/* required for down-arrow or it's blank*/
QComboBox::drop-down
{
    width: 1px;
    height: 1px;
    subcontrol-origin: margin;
    subcontrol-position: right center;
    border-left-width: 0px;
    border-right-width: 0px;
    border-top-width: 0px;
    border-bottom-width: 0px;
	padding: 1px 1px 1px 0px;
}

/* down arrow image */

QComboBox::down-arrow
{
 /*
	border: none;*/
	background: none;
	image: url(:/ui/ui_images/combobox_menu_arrows.svg);
	padding-right: 15px;
}


/******************************************************************************************/
/* ---[scroll bar]----------------------------------------------------------------------------*/
/******************************************************************************************/

QComboBox QAbstractItemView QScrollBar:vertical {

	background: black;
/* margin sets up how far the handle can travel */
	margin: 0px 0px 0px 0px;
	/*border: none;*/
	width: 10px;
}

/* Sets up the color and height of handle */
QComboBox QAbstractItemView QScrollBar::handle:vertical {
	background: rgb(255,255,255);
	border: none;
}

/* This removes the bottom button by setting the height to 0px */
QComboBox QAbstractItemView QScrollBar::add-line:vertical {
	height: 0px;
	subcontrol-position: bottom;
	subcontrol-origin: margin;
	border: none;
}

/* This removes the top button by setting the height to 0px */
QComboBox QAbstractItemView QScrollBar::sub-line:vertical {
	height: 0px;
	subcontrol-position: top;
	subcontrol-origin: margin;
	border: none;
}

/* need this to get rid of crosshatching on scrollbar background */
QComboBox QAbstractItemView QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
	background: none;
	border: none;
}


/* -------------------------------------------------------------------------------*/
/* -------------------------------------------------------------------------------*/
/* -------------------------------------------------------------------------------*/</string>
  </property>
  <widget class="QWidget" name="centralWidget">
   <property name="styleSheet">
    <string notr="true">/*-----------QWidget-----------*/
QWidget
{
	background: rgb(40, 40, 40);
}

/*----------- QComboBox ------------*/
QComboBox
{
	font: 10pt &quot;Corbel&quot;;
	border: 2px solid rgb(245, 245, 245);
	background: rgb(60, 60, 60);
	color: white;
	padding: 1px 3px 1px 4px;
 }

QComboBox QListView
{
	background-color: rgb(60, 60, 60);
	border: transparent;
	font: 10px &quot;Corbel&quot;;
	padding-left: 3px;
	padding-right: 3px;
	min-width: 35px;
}

QComboBox::item:alternate
{
	background: rgb(90, 90, 90);
}

QComboBox::item:selected
{
	border: 1px solid transparent;
	background: rgb(0,174,239);
}

QComboBox::indicator
{
	background-color: transparent;
	selection-background-color: transparent;
	color: transparent;
	selection-color: white;
}

QComboBox::drop-down
{
	width: 1px;
	height: 1px;
	subcontrol-origin: margin;
	subcontrol-position: right center;
	border-left-width: 0px;
	border-right-width: 0px;
	border-top-width: 0px;
	border-bottom-width: 0px;
	padding: 1px 1px 1px 4px;
}

/*----------- QFrame ------------*/
QFrame
{
	background: rgb(89, 89, 89);
	border: none;
}

/*-----------QLabel------------*/
QLabel
{
	font: 10pt &quot;Corbel&quot;;
	color: rgb(245, 245, 245);
}


/*-----------QLineEdit------------*/
QLineEdit
{
	background: rgb(60, 60, 60);
	border: 3px solid rgb(245, 245, 245);
	padding-bottom: 2px;
	color: rgb(245, 245, 245);
	font: 24pt &quot;Corbel&quot;;
}

QLineEdit:focus
{
	border: 3px solid white;
	padding-bottom: 2px;
}

/*----------- QToolButton ------------*/
QToolButton
{
	background: rgb(60, 60, 60);
	color: white;
	border: 2px solid rgb(245, 245, 245);
	font: 10px &quot;Corbel&quot;;
	padding: 0,1,0,0;
}

QToolButton:pressed
{
	background: rgb(245, 245, 245);
	color: black;
	border: 2px solid rgb(245, 245, 245);
	font: 10px &quot;Corbel&quot;;
	padding: 0, 1, 0, 0;
}

</string>

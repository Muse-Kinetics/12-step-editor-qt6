    <property name="styleSheet">
     <string notr="true">QComboBox
{
	font: 12px &quot;Droid Sans Mono&quot;;
	color: rgb(242, 242, 242);
	padding: 0px 0px 0px 7px;
}

QComboBox:focus
{
	border: 2px solid rgb(0, 174, 239);
}

QComboBox::drop-down
{
	color: rgb(242, 242, 242);
}

QComboBox QListView
{
	color: rgb(242, 242, 242);
}


QComboBox::down-arrow
{
    border: none;
    background: none;
    image: none;
    padding-right: 12px;
    width: 12px;
    height: 12px;
}

/* down arrow image */
QComboBox::down-arrow
{
	border: none;
	background: none;
	image: none;
	padding-right: 15px;
}</string>

   <string notr="true">/*-----------QWidget-----------*/
QWidget
{
	background: rgb(40, 40, 40);
}

/*-----------QLabel------------*/
QLabel
{
	font: 10pt &quot;Futura-Normal&quot;;
	color: rgb(245, 245, 245);
}


/*----------- QToolButton ------------*/
QToolButton
{
	background: rgb(60, 60, 60);
	color: rgb(245, 245, 245);
	border: 2px solid rgb(245, 245, 245);
	font: 12pt &quot;Futura PT&quot;;
	padding: 0, 1, 0, 0;
}

QToolButton:pressed
{
	background: rgb(245, 245, 245);
	color: rgb(60, 60, 60);
	border: 2px solid rgb(245, 245, 245);
	font: 12pt &quot;Futura PT&quot;;
	padding: 0, 1, 0, 0;
}

QCheckBox
{
	background: transparent;
	border: none;
}

QCheckBox::indicator
{
	width: 212px;
	height: 24px;
}

QCheckBox::indicator:unchecked:pressed
{
	
image: url(:/ui/ui_images/cc7_disabled_pressed.png);

}

QCheckBox::indicator:unchecked
{
	image: url(:/ui/ui_images/cc7_disabled.png);

}

QCheckBox::indicator:checked
{
	image: url(:/ui/ui_images/cc7_enabled.png);

}

QCheckBox::indicator:checked:pressed
{
	image: url(:/ui/ui_images/cc7_enabled_pressed.png);
}

/*-------QSlider-------*/
QSlider
{
	background: none;
}

/*-----VERTICAL-----*/

QSlider::groove:vertical
{
	border: none;
}

QSlider::handle:vertical
{
	background: white;
	border: none;
	height: 2px;
	
}

QSlider::add-page:vertical
{
	background: rgb(89, 89, 89);
}

QSlider::sub-page:vertical
{
	background: rgb(169, 169, 169);
}

/*-----HORIZONTAL-----*/

QSlider::groove:horizontal
{
	border: none;
}

QSlider::handle:horizontal
{
	background: white;
	border: none;
	width: 14px;
	
}

QSlider::sub-page:horizontal
{
	background: rgb(89, 89, 89);
}

QSlider::add-page:horizontal
{
	background: rgb(169, 169, 169);
}
</string>

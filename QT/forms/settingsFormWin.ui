   <property name="toolTip">
    <string>Enables/Disables &quot;velocity override&quot;.&lt;p&gt;When enabled, all presets will transmit all MIDI notes at full velocity (127), ignoring all velocity-related settings in the modlines. When disabled, all presets will respond to velocity as normal.</string>
   </property>

	selection-color: white;
}

/* required for down-arrow or it's blank*/
QComboBox::drop-down
{
	width: 1px;
	height: 1px;
	subcontrol-origin: margin;
	subcontrol-position: right center;
	border-left-width: 0px;
	border-right-width: 0px;
	border-top-width: 0px;
	border-bottom-width: 0px;
	padding: 1px 1px 1px 4px;
}

/*----------- QFrame ------------*/
QFrame
{
	background: rgb(89, 89, 89);
	border: none;
}

/*-----------QLabel------------*/
QLabel
{
	font: 12pt &quot;Futura PT&quot;;
	color: rgb(245, 245, 245);
}


/*-----------QLineEdit------------*/
QLineEdit
{
	background: rgb(60, 60, 60);
	border: 3px solid rgb(245, 245, 245);
	padding-bottom: 2px;
	color: rgb(245, 245, 245);
	font: 24pt &quot;Droid Sans Mono&quot;;
}

QLineEdit:focus
{
	border: 3px solid white;
	padding-bottom: 2px;
}

/*----------- QToolButton ------------*/
QToolButton
{
	background: rgb(60, 60, 60);
	color: white;
	border: 2px solid rgb(245, 245, 245);
	font: 10pt &quot;Futura PT&quot;;
	padding: 0,1,0,0;
}

QToolButton:pressed
{
	background: rgb(245, 245, 245);
	color: black;
	border: 2px solid rgb(245, 245, 245);
	font: 10pt &quot;Futura PT&quot;;
	padding: 0, 1, 0, 0;
}


/* down arrow image */
QComboBox::down-arrow
{
	border: none;
	background: none;
	image: url(:/ui/ui_images/combobox_menu_arrows.svg);
	padding-right: 15px;
}

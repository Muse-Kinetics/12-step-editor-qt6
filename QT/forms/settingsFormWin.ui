  <property name="styleSheet">
   <string notr="true">/*-----------QWidget-----------*/
QWidget
{
	background: rgb(40, 40, 40);
}

/*-----------QLabel------------*/
QLabel
{
	font: 12px &quot;Open Sans&quot;;
	color: rgb(245, 245, 245);
}


/*----------- QToolButton ------------*/
QToolButton
{
	background: rgb(60, 60, 60);
	color: rgb(245, 245, 245);
	border: 2px solid rgb(245, 245, 245);
	font: 14px &quot;Open Sans&quot;;
	padding: 0, 1, 0, 0;
}

QToolButton:pressed
{
	background: rgb(245, 245, 245);
	color: rgb(60, 60, 60);
	border: 2px solid rgb(245, 245, 245);
	font: 12pt &quot;Open Sans&quot;;
	padding: 0, 1, 0, 0;
}

/*----------- QCheckBox ------------*/
QCheckBox
{
	background: transparent;
	border: none;
}

QCheckBox::indicator
{
	width: 90;
    height: 24;
    background-size: contain;
    background-repeat: no-repeat;
}

QCheckBox::indicator:unchecked:pressed
{
	
image: url(:/ui/ui_images/button/button_disabled_pressed.svg);

}

QCheckBox::indicator:unchecked
{
	image: url(:/ui/ui_images/button/button_disabled.svg);

}

QCheckBox::indicator:checked
{
	image: url(:/ui/ui_images/button/button_enabled.svg);

}

QCheckBox::indicator:checked:pressed
{
	image: url(:/ui/ui_images/button/button_enabled_pressed.svg);
}

/*-------QSlider-------*/
QSlider
{
	background: none;
}

/*-----VERTICAL-----*/

QSlider::groove:vertical
{
	border: none;
}

QSlider::handle:vertical
{
	background: white;
	border: none;
	height: 2px;
	
}

QSlider::add-page:vertical
{
	background: rgb(89, 89, 89);
}

QSlider::sub-page:vertical
{
	background: rgb(169, 169, 169);
}


/*-----HORIZONTAL-----*/

QSlider::groove:horizontal
{
	border: none;
}

QSlider::handle:horizontal
{
	background: white;
	border: none;
	width: 14px;
	
}


QSlider::add-page:horizontal
{
	background: rgb(89, 89, 89);
}

QSlider::sub-page:horizontal
{
	background: rgb(169, 169, 169);
}

/*---------------------------*/

/*----------- QComboBox ------------*/
QComboBox
{
	font: 14px &quot;Open Sans&quot;;
	border: 2px solid rgb(245, 245, 245);
	background: rgb(60, 60, 60);
	color: white;
	padding: 1px 3px 1px 4px;
    combobox-popup: 0;
 }

/*----------- QComboBox ------------*/

/* dropdown box*/
QComboBox QListView
{
    border: 1px solid rgb(255,255,255);
	color: white;
	font: 10px &quot;Open Sans&quot;;
	padding-left: 3px;
	padding-right: 3px;
	min-width: 100px;
    height: 200px;
}

/*----------- dropdown items hovered ------------*/
QComboBox QAbstractItemView
{
    background-color: rgb(40, 40, 40);
    selection-color: white;
    selection-background-color: rgb(0,174,239);
    min-width: 200px;
}

QComboBox::item:alternate
{
	background: rgb(90, 90, 90);
}

QComboBox::item:selected
{
	border: 1px solid transparent;
	background: rgb(0,174,239);
}

QComboBox::indicator
{
	background-color: transparent;
	selection-background-color: transparent;
	color: transparent;
	selection-color: white;
}

/* down arrow image */
QComboBox::down-arrow
{
    border: none;
    background: none;
    image: url(:/ui/ui_images/combobox_menu_arrows.svg);
    padding-right: 12px;
    width: 12px;
    height: 12px;
}

/* required for down-arrow or it's blank*/
QComboBox::drop-down
{
    width: 1px;
    height: 1px;
    subcontrol-origin: margin;
    subcontrol-position: right center;
    border-left-width: 0px;
    border-right-width: 0px;
    border-top-width: 0px;
    border-bottom-width: 0px;
	padding: 1px 1px 1px 4px;
}

/* down arrow image */
QComboBox::down-arrow
{
	border: none;
	background: none;
	image: url(:/ui/ui_images/combobox_menu_arrows.svg);
	padding-right: 15px;
}

/* ---[scroll bar]----------------------------------------------------------------------------*/

QComboBox QAbstractItemView QScrollBar:vertical {
	background: black;
/* margin sets up how far the handle can travel */
	margin: 0px 0px 0px 0px;
	border: none;
}

/* Sets up the color and height of handle */
QComboBox QAbstractItemView QScrollBar::handle:vertical {
	background: rgb(255,255,255);
	border: none;
}

/* This removes the bottom button by setting the height to 0px */
QComboBox QAbstractItemView QScrollBar::add-line:vertical {
	height: 0px;
	subcontrol-position: bottom;
	subcontrol-origin: margin;
	border: none;
}

/* This remvoes the top button by setting the height to 0px */
QComboBox QAbstractItemView QScrollBar::sub-line:vertical {
	height: 0px;
	subcontrol-position: top;
	subcontrol-origin: margin;
	border: none;
}

/* need this to get rid of crosshatching on scrollbar background */
QComboBox QAbstractItemView QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
	background: none;
	border: none;
}



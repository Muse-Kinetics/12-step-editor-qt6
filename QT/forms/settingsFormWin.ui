   <property name="toolTip">
    <string>Enables/Disables the CC 7 127 message the 12 Step &lt;br&gt;automatically outputs on preset changes.</string>
   </property>
   <property name="styleSheet">
    <string notr="true">QCheckBox
{
	background: transparent;
	border: none;
}

QCheckBox::indicator
{
	width: 212px;
	height: 24px;
}

QCheckBox::indicator:unchecked:pressed
{
	image: url(:/ui/ui_images/cc7_disabled_pressed.png);
}

QCheckBox::indicator:unchecked
{
	image: url(:/ui/ui_images/cc7_disabled.png);
}

QCheckBox::indicator:checked
{
	image: url(:/ui/ui_images/cc7_enabled.png);
}

QCheckBox::indicator:checked:pressed
{
	image: url(:/ui/ui_images/cc7_enabled_pressed.png);
}</string>

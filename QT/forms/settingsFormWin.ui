   <property name="toolTip">
    <string>Adjusts the sensitivity of the 12 Step keys.&lt;p&gt;Moving the slider to the right (toward the &quot;+&quot; symbol) increases sensitivity — moving the slider to the left (toward the &quot;-&quot; symbol) decreases sensitivity.</string>
   </property>
   <property name="maximum">
    <number>500</number>
   </property>
   <property name="orientation">

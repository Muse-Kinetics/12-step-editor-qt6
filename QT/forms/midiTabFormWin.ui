  <property name="styleSheet">
   <string notr="true">/**************WIDGET**************/
QWidget
{
	
	background-color: rgb(40, 40, 40);

}

/**************LABEL**************/
QLabel
{
	font: 9pt &quot;Futura-Normal&quot;;
	color: rgb(242, 242, 242);
	background-color: transparent;
}

/**************SPINBOX**************/
QSpinBox
{
	font: 10pt &quot;Futura-Normal&quot;;
	color: rgb(242, 242, 242);
	background-color: rgb(60, 60, 60);
	border: 2px solid rgb(242, 242, 242);
}

QSpinBox:focus
{
	border: 2px solid rgb(0, 174, 239);
}

/**************DOUBLESPINBOX**************/
QDoubleSpinBox
{
	font: 10pt &quot;Futura-Normal&quot;;
	color: rgb(242, 242, 242);
	background-color: rgb(60, 60, 60);
	border: 2px solid rgb(242, 242, 242);
}

QDoubleSpinBox:focus
{
	border: 2px solid rgb(0, 174, 239);
}

/**************TOOLBUTTON**************/
QToolButton
{
	border: none;
	background-color: transparent;
	color: transparent;
}

/**************RADIOBUTTON**************/
QRadioButton
{
	border: none;
	background-color: transparent;
/* needs to be handled in each individual button
    because text cannot be center aligned with radio buttons */
}

QRadioButton::indicator
{
	width: 0px;
	height: 0px;
}
</string>
  </property>

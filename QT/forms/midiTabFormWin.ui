   <widget class="QRadioButton" name="keySafetySingleKey">
    <property name="geometry">
     <rect>
      <x>88</x>
      <y>1</y>
      <width>103</width>
      <height>27</height>
     </rect>
    </property>
    <property name="toolTip">
     <string>Sets how many keys can be activated simultaneously.&lt;p&gt;&lt;b&gt;Single Key&lt;/b&gt;: Only one key can be activated at a time.&lt;p&gt;&lt;b&gt;Multi Key&lt;/b&gt;: All keys can be activated at any time.</string>
    </property>
    <property name="styleSheet">
     <string notr="true">QRadioButton
{

}

QRadioButton::unchecked
{
	image: url(:/ui/ui_images/keysafety_singlekey_inactive.png);
}

QRadioButton::checked
{
	image: url(:/ui/ui_images/keysafety_singlekey_active.png);
}

QRadioButton::unchecked:pressed
{
	image: url(:/ui/ui_images/keysafety_singlekey_pressed.png);
}

QRadioButton::checked:pressed
{
	image: url(:/ui/ui_images/keysafety_singlekey_pressed.png);
}

QRadioButton::unchecked:focus
{
	image: url(:/ui/ui_images/keysafety_singlekey_inactive_focus.png);
}

QRadioButton::checked:focus
{
	image: url(:/ui/ui_images/keysafety_singlekey_active_focus.png);
}</string>
    </property>
    <property name="text">
     <string/>
    </property>
    <property name="checkable">
     <bool>true</bool>
    </property>
   </widget>

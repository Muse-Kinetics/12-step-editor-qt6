   <property name="toolTip">
    <string>Sets the way notes behave when triggered.&lt;p&gt;&lt;b&gt;Normal&lt;/b&gt;: Notes will turn on when a key is pressed and turn off when the key is released.&lt;p&gt;&lt;b&gt;Legato&lt;/b&gt;: Notes will turn on when a key is pressed and continue playing when released. When another key is pressed, the previous notes will turn off and the new key's notes will turn on.&lt;p&gt;&lt;b&gt;Toggle&lt;/b&gt;: Notes will turn on when a key is pressed and stay on until the key is pressed again.&lt;p&gt;&lt;b&gt;Hold&lt;/b&gt;: Allows toggling between Normal and Legato mode using the Select key.</string>
   </property>
   <property name="text">
    <string>Note Mode</string>
   </property>
